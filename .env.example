# ==============================================================================
# Botiquín (AI Expert Chat) — variables de entorno
#
# Copia este archivo a .env (o ejecuta `npm run env:init`, que lo hace y genera
# los secretos por ti) y completa los valores.
# NUNCA subas el archivo .env a GitHub: contiene secretos.
# ==============================================================================

# --- Base de datos (Supabase / PostgreSQL) ------------------------------------
# Local con Docker (`npm run db:up`):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aiexpert
#
# Supabase: botón «Connect» en la parte superior del proyecto → copia la cadena y cambia [YOUR-PASSWORD].
#   · Migraciones y seed desde tu PC → "Session pooler" (puerto 5432, funciona con IPv4)
#   · Producción en Vercel           → "Transaction pooler" (puerto 6543)
#   Ejemplo: postgresql://postgres.<ref>:<PASSWORD>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
#   Copia el host exacto desde «Connect»: el número y la región cambian de un proyecto a otro.
#   Si la contraseña tiene caracteres especiales (@ # / : ? % &) debes codificarlos (URL-encode).
#
# SSL: auto (por defecto: se activa si el host no es local) | true | false
DATABASE_SSL=auto
DATABASE_POOL_MAX=5

# --- Sesiones -----------------------------------------------------------------
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera uno con `npm run env:init` o con: openssl rand -base64 32
AUTH_SECRET=

# --- Proveedor de IA ----------------------------------------------------------
# mock   → respuestas simuladas (Taller 2). No necesita clave.
# groq | gemini | openai → modelo real (Proyecto de IA). Requieren AI_API_KEY.
# ollama | custom        → endpoint compatible con OpenAI (define AI_BASE_URL).
AI_PROVIDER=mock
AI_API_KEY=
# Opcional: modelo a usar (si se deja vacío se usa el modelo por defecto del proveedor).
# También se puede cambiar en caliente desde el panel de administración.
AI_MODEL=
# Solo para ollama / custom. Ejemplo Ollama: http://localhost:11434/v1
AI_BASE_URL=
AI_TIMEOUT_MS=50000
AI_MAX_RETRIES=1
# Opcional, modelos de razonamiento: minimal | low | medium | high
AI_REASONING_EFFORT=

# --- Especialidad del asistente -----------------------------------------------
# Plantilla con la que se crea el asistente la primera vez (y a la que vuelve «Restablecer»):
#   salud | programacion | deporte | mecanica | gastronomia | turismo
# Después se puede cambiar en caliente desde Administración → Asistente → «Cargar plantilla».
# Ver docs/PLANTILLAS_ESPECIALIDAD.md.
ASSISTANT_PRESET=salud

# --- Límites ------------------------------------------------------------------
# Máximo de mensajes por usuario por minuto (protege tu cuota de la API de IA).
CHAT_RATE_LIMIT_PER_MIN=15
# Opcional: zona horaria de las estadísticas diarias del panel de administración.
# STATS_TIMEZONE=America/Bogota
# Opcional: false desactiva los títulos de conversación generados por el modelo.
# AI_AUTO_TITLE=true

# --- Cuenta ADMIN inicial (la crea `npm run db:seed`) --------------------------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Crea además un usuario USER de demostración (útil para probar los roles).
SEED_DEMO_USER=false
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=
